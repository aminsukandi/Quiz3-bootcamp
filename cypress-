describe('TEST AUTO orangeHRM', () => {
  //memastikan halaman login

  it('TC01-open login view', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    //cy.screenshot()
    
  });

  // memastikan input username tampil
  it('TC02-memastikan input username tampil', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="username"]').should('be.visible')
    //cy.screenshot()
  })

  //memastikan input password tampil
  it('TC03-memastikan input password tampil', () => {
     cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
     cy.get('input[name="password"]').should('be.visible')
     //cy.screenshot()

  })

  //memastikan button login tampil
  it('TC04- memastikan bbutton login tampil', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('.oxd-button[type="submit"]').click();
    //cy.screenshot()

  })

  //input username
  it('TC05-input username', ()=> {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="username"]').type('Admin')
    cy.get('input[name="username"]').should('have.value','Admin')
    //cy.screenshot()
  })

    //input username
  it('TC06-input password', ()=> {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="password"]').type('admin123')
    cy.get('input[name="password"]').should('have.value', 'admin123')
    //cy.screenshot()
    
  })

  //Login menggunakan data valid
  it('TC07 - Login dengan data valid', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="username"]').type('Admin')
    cy.get('input[name="password"]').type('admin123')
    cy.get('button[type="submit"]').click()
     cy.contains('Dashboard').should('be.visible')
    //cy.screenshot('')
    
    cy.get('#app div.emp-attendance-chart canvas').click();
  })

  //Login dengan username salah
  it('TC08 - Login dengan username salah', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="username"]').type('SalahUser')
    cy.get('input[name="password"]').type('admin123')
    cy.get('button[type="submit"]').click()
    cy.contains('Invalid credentials').should('be.visible')
    //cy.screenshot()
  })

   //Login dengan password salah
  it('TC09 - Login dengan password salah', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="username"]').type('Admin')
    cy.get('input[name="password"]').type('passwordSalah')
    cy.get('button[type="submit"]').click()
    cy.contains('Invalid credentials').should('be.visible')
    //cy.screenshot()
  })

  
  //Login dengan username kosong
  it('TC10 - Login dengan username kosong', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="password"]').type('admin123')
    cy.get('button[type="submit"]').click()
    cy.get('input[name="username"]')
      .parents('.oxd-input-group')
      .should('contain', 'Required')
  //cy.screenshot()
  })

//Login dengan password kosong
  it('TC11 - Login dengan password kosong', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="username"]').type('Admin')
    cy.get('button[type="submit"]').click()
    cy.get('input[name="password"]')
      .parents('.oxd-input-group')
      .should('contain', 'Required')
    //cy.screenshot()
  })

  //Memastikan dashboard tampil setelah login
  it('TC12 - Memastikan dashboard tampil', () => {
    cy.visit('https://opensource-demo.orangehrmlive.com/web/index.php/auth/login')
    cy.get('input[name="username"]').type('Admin')
    cy.get('input[name="password"]').type('admin123')
    cy.get('button[type="submit"]').click()
    cy.contains('Dashboard').should('be.visible')
    //cy.screenshot()
  })
  


})
